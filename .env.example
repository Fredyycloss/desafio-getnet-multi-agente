APP_ENV=demo
API_PORT=8000
FRONTEND_PORT=8080

# --- LLM provider -------------------------------------------------------------
# auto: GETNET_ANTHROPIC_API_KEY set -> cloud (Claude Haiku 5.5); otherwise local Ollama when
# OLLAMA_ENABLED=true (scripts/start-ai.sh); otherwise deterministic fallback. ollama|anthropic|none force a mode.
LLM_PROVIDER=auto
# Cloud key. Never use ANTHROPIC_API_KEY; never commit this file.
GETNET_ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_EFFORT=low
ANTHROPIC_THINKING=disabled
ANTHROPIC_MIN_OUTPUT_TOKENS=1024
# Price per million tokens used for /api/metrics cost (Haiku 5.5, prompts <= 100K tokens).
ANTHROPIC_INPUT_USD_PER_MTOK=0.10
ANTHROPIC_OUTPUT_USD_PER_MTOK=0.50
# At startup the API makes one minimal request (1 output token) so /api/health can say whether
# the key was refused (401/403) or the account has no credit. Set to false to skip it.
ANTHROPIC_STARTUP_CHECK=true
# Optional offline fallback. If the cloud key is refused or out of credit, switch every later call
# to the local Ollama model (shown in /api/health and in each response trace). It needs the local
# model downloaded once: docker compose --profile ai up -d ollama-models
# LLM_FALLBACK_PROVIDER=ollama
# Request-wide LLM budget per profile (seconds). REQUEST_LLM_BUDGET_SECONDS overrides both when set.
CLOUD_LLM_BUDGET_SECONDS=30
LOCAL_LLM_BUDGET_SECONDS=150

# --- Demo authentication ------------------------------------------------------------
# HMAC secret for demo tokens. Empty = a random secret per API start (tokens die on restart).
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# --- Human operators -----------------------------------------------------------------
# DEMO_MODE=true creates the public demo operator accounts and the demo customer logins.
DEMO_MODE=true
OPERATOR_TOKEN_TTL_SECONDS=28800
# Telegram channel (docs/HITL.md): token from @BotFather, operators' group id, allowed user ids.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
TELEGRAM_OPERATOR_IDS=

# --- Local Ollama (offline mode and embeddings) ----------------------------------------
OLLAMA_ENABLED=false
OLLAMA_REQUIRED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_STARTUP_TIMEOUT_SECONDS=900
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=256
OLLAMA_CONTEXT_MAX_OUTPUT_TOKENS=180
OLLAMA_KNOWLEDGE_MAX_OUTPUT_TOKENS=160
OLLAMA_CRITIC_MAX_OUTPUT_TOKENS=60
OLLAMA_SUPPORT_MAX_OUTPUT_TOKENS=80
OLLAMA_SUPPORT_ANSWER_MAX_OUTPUT_TOKENS=180
OLLAMA_WEB_TOOL_MAX_OUTPUT_TOKENS=60
OLLAMA_WEB_ANSWER_MAX_OUTPUT_TOKENS=150
OLLAMA_SUPERVISOR_MAX_OUTPUT_TOKENS=200
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false
# Optional override of the provider budget. Empty = profile value above.
# When spent, a labelled deterministic answer (degraded=true) is returned.
REQUEST_LLM_BUDGET_SECONDS=
# Optional CPU threads for the local model (empty = Ollama default).
OLLAMA_NUM_THREAD=
# Context Intelligence confidence needed to dispatch one specialist without a planning call.
SUPERVISOR_FAST_PATH_MIN_CONFIDENCE=0.75
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_PORT=11434
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REQUEST_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO

# Optional key for the simulated operator API; set a long random value to enable it.
OPERATOR_API_KEY=
